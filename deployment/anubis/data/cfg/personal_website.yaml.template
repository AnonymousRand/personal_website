bots:
  - name: "block-enumeration"
    expression: >-
      path.startsWith("/wp-")
      || path.endsWith(".php")
      || path.endsWith(".env")
      || path.startsWith("/.git")
      || path.startsWith("/.aws")
    action: CHALLENGE
    challenge:
      # impossible challenge; intentionally waste their compute >:3
      difficulty: 16
      algorithm: fast

  ## the docker bind mount/extends setup i have should ensure that this relative path
  ## is correct inside the container :3
  #- import: ./base_bot_policies.yaml
  # it seems that relative paths are actually currently broken!! >:(
  - import: ${ANUBIS_CONFIG_DEST_DIR}/base_bot_policies.yaml

    # (this is probably covered under ajax below, but just in case)
    # SYNC: urls/endpoints!
  - name: "allow-auth-status"
    expression: 'path == "/auth-status"'
    action: ALLOW

  - name: "allow-ajax"
    # SYNC: make sure all requests that should be always allowed are matched by this!
    expression:
      all:
        - '"Accept" in headers'
        - 'headers["Accept"] == "application/json"'
    action: ALLOW

  - name: "allow-css-js"
    expression: 'path.endsWith(".css") || path.endsWith(".js")'
    action: ALLOW

  - name: "allow-fonts"
    # SYNC: all font file types used! since some browsers (safari) don't send specific `Accept` >:(
    expression: >-
      ("Accept" in headers && headers["Accept"].contains("font"))
      || (path.endsWith(".ttf") || path.endsWith(".woff2"))
    action: ALLOW

  - name: "allow-images"
    expression:
      all:
        - '"Accept" in headers'
        - 'headers["Accept"].contains("image")'
    action: ALLOW

  # import this at end since policies are evaluated in written order
  #- import: ./catch_all_bot_policies.yaml
  - import: ${ANUBIS_CONFIG_DEST_DIR}/catch_all_bot_policies.yaml

# data storage
store:
  backend: bbolt
  parameters:
    path: ${PERSONAL_WEBSITE_ANUBIS_VAR_DEST_DIR}/anubis.bdb

# honeypot
honeypot:
  enabled: true
  # currently the only supported implementation is the naive method
  implementation: naive
  # write ips that keep hitting honeypots to a file that can be used for e.g. fail2ban
  ip_log_file: ${PERSONAL_WEBSITE_ANUBIS_VAR_DEST_DIR}/honeypot.addrs

# don't use dns black list due to false positives and privacy concerns
dnsbl: false

# by default, send http 200 back to clients that either get issued a challenge
# or a denial. this seems weird, but this is load-bearing due to the fact that
# the most aggressive scraper bots seem to really, really, want an http 200 and
# will stop sending requests once they get it
status_codes:
  CHALLENGE: 200
  DENY: 200

